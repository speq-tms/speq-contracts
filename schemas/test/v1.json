{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speq.dev/schemas/test/v1.json",
  "title": "speq test spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending"],
      "description": "ATDD lifecycle status. When set to 'pending', the test is skipped and reported as pending."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["api", "use"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pending"],
          "description": "ATDD lifecycle status. When set to 'pending', the step is skipped and all dependent subsequent steps cascade to pending."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api"
              }
            }
          },
          "then": {
            "required": ["method", "url"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "use"
              }
            }
          },
          "then": {
            "required": ["ref"]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["status", "json", "contains", "notcontains", "exists", "regex"]
        },
        "path": {
          "type": "string"
        },
        "expected": {},
        "value": {}
      }
    }
  }
}
