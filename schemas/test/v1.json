{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speq.dev/schemas/test/v1.json",
  "title": "speq test spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "number", "boolean", "null"] },
          { "$ref": "#/$defs/genValue" }
        ]
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "genValue": {
      "type": "object",
      "required": ["gen"],
      "additionalProperties": false,
      "properties": {
        "gen": { "$ref": "#/$defs/genConfig" }
      }
    },
    "genConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["uuid", "date-time", "string", "int", "bool", "email", "name"]
        },
        "format": {
          "type": "string",
          "enum": ["rfc3339", "iso8601"],
          "description": "Only for type: date-time"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Only for type: string"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Only for type: string"
        },
        "min": {
          "type": "integer",
          "description": "Only for type: int"
        },
        "max": {
          "type": "integer",
          "description": "Only for type: int"
        }
      }
    },
    "bodyValue": {
      "description": "A body field value: plain JSON or a gen block",
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "$ref": "#/$defs/genValue" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/bodyValue" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/bodyValue" }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["api", "use"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "$ref": "#/$defs/bodyValue"
        },
        "bodyFromFixture": {
          "$ref": "#/$defs/bodyFromFixture"
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api"
              }
            }
          },
          "then": {
            "required": ["method", "url"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "use"
              }
            }
          },
          "then": {
            "required": ["ref"]
          }
        }
      ]
    },
    "bodyFromFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "description": "Use a fixture file as the request body.",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the fixture file relative to fixturesDir."
        },
        "overrides": {
          "type": "object",
          "additionalProperties": true,
          "description": "Key-value pairs that override fixture build values."
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["status", "json", "contains", "notcontains", "exists", "regex", "schema"]
        },
        "path": {
          "type": "string"
        },
        "expected": {},
        "value": {},
        "ref": {
          "type": "string",
          "description": "Schema file reference (only for type: schema)."
        },
        "inline": {
          "description": "Inline JSON Schema (only for type: schema)."
        }
      }
    }
  }
}
