{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speq.dev/schemas/manifest/v1.json",
  "title": "speq manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "defaultEnvironment"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "defaultEnvironment": {
      "type": "string",
      "minLength": 1
    },
    "environmentsDir": {
      "type": "string",
      "minLength": 1,
      "default": "environments"
    },
    "suitesDir": {
      "type": "string",
      "minLength": 1,
      "default": "suites"
    },
    "reportsDir": {
      "type": "string",
      "minLength": 1,
      "default": "reports"
    }
  }
}
