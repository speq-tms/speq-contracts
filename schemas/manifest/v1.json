{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speq.dev/schemas/manifest/v1.json",
  "title": "speq manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "defaultEnvironment"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "defaultEnvironment": {
      "type": "string",
      "minLength": 1
    },
    "environmentsDir": {
      "type": "string",
      "minLength": 1,
      "default": "environments"
    },
    "suitesDir": {
      "type": "string",
      "minLength": 1,
      "default": "suites"
    },
    "reportsDir": {
      "type": "string",
      "minLength": 1,
      "default": "reports"
    },
    "schemasDir": {
      "type": "string",
      "minLength": 1,
      "default": "schemas"
    },
    "modulesDir": {
      "type": "string",
      "minLength": 1,
      "default": "modules"
    },
    "fixturesDir": {
      "type": "string",
      "minLength": 1,
      "default": "fixtures",
      "description": "Directory for fixture files. Defaults to 'fixtures'."
    },
    "retry": {
      "$ref": "#/$defs/retryConfig",
      "description": "Global retry policy applied to all API steps."
    }
  },
  "$defs": {
    "retryConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Global retry configuration for API steps.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable retry globally."
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum number of attempts per HTTP call."
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Base delay between retries in milliseconds."
        },
        "backoff": {
          "type": "string",
          "enum": ["fixed", "exponential"],
          "default": "fixed",
          "description": "Backoff strategy: fixed delay or exponential."
        },
        "retryOn": {
          "type": "object",
          "additionalProperties": false,
          "description": "Conditions under which to retry.",
          "properties": {
            "networkErrors": {
              "type": "boolean",
              "default": false,
              "description": "Retry on network-level errors."
            },
            "statusCodes": {
              "type": "array",
              "items": { "type": "integer", "minimum": 100, "maximum": 599 },
              "default": [],
              "description": "HTTP status codes that trigger a retry."
            }
          }
        }
      }
    }
  }
}
